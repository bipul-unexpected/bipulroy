VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
# Disable public signup in Clerk and allowlist only the owner account.
# The admin dashboard also requires this user's public metadata: {"role":"admin"}.

# Appwrite Sites / Web SDK
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
VITE_APPWRITE_DATABASE_ID=portfolio
VITE_APPWRITE_PROJECTS_COLLECTION_ID=projects
VITE_APPWRITE_ARTICLES_COLLECTION_ID=articles
VITE_APPWRITE_GALLERY_COLLECTION_ID=gallery
VITE_APPWRITE_TOOLS_COLLECTION_ID=tools
VITE_APPWRITE_EXPERIENCE_COLLECTION_ID=experience
VITE_APPWRITE_SERVICES_COLLECTION_ID=services
VITE_APPWRITE_TESTIMONIALS_COLLECTION_ID=testimonials
VITE_APPWRITE_STORAGE_BUCKET_ID=portfolio-media
# Public HTTPS URL of the deployed Appwrite Function that handles admin writes.
VITE_APPWRITE_ADMIN_FUNCTION_URL=https://your-function-domain.appwrite.global
# The Function itself uses ALLOWED_ORIGIN=https://your-portfolio-domain.com.

# Web3Forms (the access key is safe to expose in a browser form)
VITE_WEB3FORMS_ACCESS_KEY=39f9a6b3-763c-4ef6-bf81-06128530394d
